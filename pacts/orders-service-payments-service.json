{
  "consumer": {
    "name": "orders-service"
  },
  "interactions": [
    {
      "description": "a charge for a customer with a valid card",
      "providerStates": [
        {
          "name": "customer c-42 has a valid card"
        }
      ],
      "request": {
        "body": {
          "amountCents": 1000,
          "customerId": "c-42"
        },
        "headers": {
          "content-type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.amountCents": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/payments"
      },
      "response": {
        "body": {
          "paymentId": "p-1",
          "status": "APPROVED"
        },
        "headers": {
          "content-type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.paymentId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 201
      }
    },
    {
      "description": "a charge for a customer whose card is declined",
      "providerStates": [
        {
          "name": "customer c-13 has a card that will be declined"
        }
      ],
      "request": {
        "body": {
          "amountCents": 1000,
          "customerId": "c-13"
        },
        "headers": {
          "content-type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.amountCents": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/payments"
      },
      "response": {
        "body": {
          "status": "DECLINED"
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 402
      }
    }
  ],
  "metadata": {
    "pactRust": {
      "consumer": "1.4.10",
      "mockserver": "2.2.5",
      "models": "1.3.15"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "payments-service"
  }
}